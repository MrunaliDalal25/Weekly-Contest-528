
class Solution {
    public long maxDifference(int[] nums) {

        int n = nums.length;

        long[] dp = new long[n + 1];

        dp[n] = 0;

        for (int i = n - 1; i >= 0; i--) {

            // Option 1: Take one element
            long sum1 = nums[i];

            long option1;

            if (sum1 % 3 == 0) {
                option1 = sum1 - dp[i + 1];
            } else {
                option1 = sum1 + dp[i + 1];
            }

            dp[i] = option1;

            // Option 2: Take two elements
            if (i + 1 < n) {

                long sum2 = (long) nums[i] + nums[i + 1];

                long option2;

                if (sum2 % 3 == 0) {
                    option2 = sum2 - dp[i + 2];
                } else {
                    option2 = sum2 + dp[i + 2];
                }

                dp[i] = Math.max(dp[i], option2);
            }
        }

        return dp[0];
    }
}
